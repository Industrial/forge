#!/usr/bin/env bash
set -euo pipefail

# Backend integration tests: run from project root. Start API server, then run Rust integration tests.
# Used by: moon test-integration (from project root after forge new).
# Uses random ports (>= 30000) via FORGE_SERVER_PORT/FORGE_FRONTEND_PORT so env overrides config.

ROOT="$(pwd)"
PROJECT_NAME="${PROJECT_NAME:-$(basename "$ROOT")}"

# Random ports above 30000 so multiple runs or parallel jobs don't clash
FORGE_BACKEND_HOST="${FORGE_BACKEND_HOST:-127.0.0.1}"
FORGE_SERVER_PORT="${FORGE_SERVER_PORT:-$((30000 + RANDOM % 2768))}"
FORGE_FRONTEND_PORT="${FORGE_FRONTEND_PORT:-$((30000 + RANDOM % 2768))}"
export FORGE_BACKEND_HOST
export FORGE_SERVER_PORT
export FORGE_FRONTEND_PORT

echo "> test-integration (backend port $FORGE_SERVER_PORT, frontend port $FORGE_FRONTEND_PORT)"

# Build the project
echo "> test-integration > cargo build"
cargo build

# Config files must exist; ports are overridden by FORGE_SERVER_PORT / FORGE_FRONTEND_PORT
echo "> test-integration > writing config (ports from env)"
mkdir -p config
cat > config/app.toml <<EOF
[app]
name = "$PROJECT_NAME"

[server]
host = "127.0.0.1"
port = 4000

[frontend]
port = 3000
EOF

# Use a temporary database file; forge-config reads FORGE_DATABASE_URL
E2E_DB_PATH="${ROOT}/data/forge_integration_$$.sqlite"
mkdir -p "${ROOT}/data"
rm -f "$E2E_DB_PATH"
export FORGE_DATABASE_URL="sqlite://${E2E_DB_PATH}?mode=rwc"
export E2E_DB_PATH

API_PID=""
API_URL="http://${FORGE_BACKEND_HOST}:${FORGE_SERVER_PORT}"
cleanup() {
  if [[ -n "${API_PID:-}" ]] && kill -0 "$API_PID" 2>/dev/null; then
    kill "$API_PID" 2>/dev/null || true
    wait "$API_PID" 2>/dev/null || true
  fi
}
trap cleanup EXIT

echo "> test-integration > starting API server (port $FORGE_SERVER_PORT)"
FORGE_ENVIRONMENT=development FORGE_BACKEND_HOST="$FORGE_BACKEND_HOST" FORGE_SERVER_PORT="$FORGE_SERVER_PORT" FORGE_DATABASE_URL="$FORGE_DATABASE_URL" cargo run -p server --quiet &
API_PID=$!

# Migrations + seeds can take 60s+ on CI; wait up to 90s for /healthz
echo "> test-integration > waiting for API /healthz (up to 90s)"
for i in {1..180}; do
  if curl -sf --max-time 2 "$API_URL/healthz" >/dev/null 2>&1; then
    break
  fi
  if [[ $i -eq 180 ]]; then
    echo "> test-integration > API did not become ready in time"
    exit 1
  fi
  sleep 0.5
done

echo "> test-integration > running integration tests (cargo test -p test-integration)"
RUSTFLAGS="${RUSTFLAGS:--D warnings}" cargo test -p test-integration -- --test-threads=1
echo "> test-integration > done"

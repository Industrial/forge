#!/usr/bin/env bash
set -euo pipefail

# Backend integration tests: run from project root. Start API server, then run Rust integration tests.
# Used by: moon test-integration (from project root after forge new).

INTEGRATION_API_PORT=30998
ROOT="$(pwd)"
PROJECT_NAME="${PROJECT_NAME:-$(basename "$ROOT")}"

echo "> test-integration"

# Build the project
echo "> test-integration > cargo build"
cargo build

# Single config and DB for the run (use development so rate limiting is off)
echo "> test-integration > writing config (API port $INTEGRATION_API_PORT)"
mkdir -p config
cat > config/app.toml <<EOF
[app]
name = "$PROJECT_NAME"

[server]
host = "127.0.0.1"
port = $INTEGRATION_API_PORT

[frontend]
port = 3000
EOF

# Use a temporary database file in the project directory for integration tests
# Don't overwrite config/db.toml - use environment variable override instead
E2E_DB_PATH="${ROOT}/data/forge_integration_$$.sqlite"
mkdir -p "${ROOT}/data"
rm -f "$E2E_DB_PATH"
# Override database URL via environment variable (forge-config supports FORGE_DATABASE_URL)
export FORGE_DATABASE_URL="sqlite://${E2E_DB_PATH}?mode=rwc"
export E2E_DB_PATH

API_PID=""
API_URL="http://127.0.0.1:${INTEGRATION_API_PORT}"
cleanup() {
  if [[ -n "${API_PID:-}" ]] && kill -0 "$API_PID" 2>/dev/null; then
    kill "$API_PID" 2>/dev/null || true
    wait "$API_PID" 2>/dev/null || true
  fi
}
trap cleanup EXIT

echo "> test-integration > starting API server (port $INTEGRATION_API_PORT)"
FORGE_ENVIRONMENT=development cargo run --quiet &
API_PID=$!

echo "> test-integration > waiting for API /healthz"
for i in {1..100}; do
  if curl -sf --max-time 1 "$API_URL/healthz" >/dev/null 2>&1; then
    break
  fi
  if [[ $i -eq 100 ]]; then
    echo "> test-integration > API did not become ready in time"
    exit 1
  fi
  sleep 0.3
done

export E2E_API_URL="$API_URL"
export E2E_BASE_URL="$API_URL"

echo "> test-integration > running integration tests (cargo test -p test-integration)"
RUSTFLAGS="${RUSTFLAGS:--D warnings}" cargo test -p test-integration -- --test-threads=1
echo "> test-integration > done"

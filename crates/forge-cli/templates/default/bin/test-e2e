#!/usr/bin/env bash
set -euo pipefail

# E2E tests: run from project root. Start API + Vite, then run Playwright tests in crates/test-e2e/.
# Used by: moon test-e2e (from project root after forge new).

# Random ports above 30000; can be overridden by caller
FORGE_BACKEND_HOST="${FORGE_BACKEND_HOST:-127.0.0.1}"
FORGE_SERVER_PORT="${FORGE_SERVER_PORT:-$((30000 + RANDOM % 2768))}"
FORGE_FRONTEND_HOST="${FORGE_FRONTEND_HOST:-127.0.0.1}"
FORGE_FRONTEND_PORT="${FORGE_FRONTEND_PORT:-$((30000 + RANDOM % 2768))}"
export FORGE_BACKEND_HOST FORGE_SERVER_PORT FORGE_FRONTEND_HOST FORGE_FRONTEND_PORT

ROOT="$(pwd)"
PROJECT_NAME="${PROJECT_NAME:-$(basename "$ROOT")}"

echo "> test-e2e (backend $FORGE_BACKEND_HOST:$FORGE_SERVER_PORT, frontend $FORGE_FRONTEND_HOST:$FORGE_FRONTEND_PORT)"

# Build the project
echo "> test-e2e > cargo build"
cargo build

# Frontend deps (Vite dev server used for E2E)
if [[ -f frontend/package.json ]]; then
  echo "> test-e2e > bun install (frontend)"
  (cd frontend && bun install --frozen-lockfile 2>/dev/null || bun install)
fi

# Config files must exist; ports/hosts overridden by FORGE_* env vars
export FORGE_ENVIRONMENT=production
echo "> test-e2e > writing config"
mkdir -p config
cat > config/app.toml <<EOF
[app]
name = "$PROJECT_NAME"

[server]
host = "127.0.0.1"
port = 4000

[frontend]
host = "127.0.0.1"
port = 3000
EOF

# Use a temporary database file in the project directory for e2e tests
# Don't overwrite config/db.toml - use environment variable override instead
E2E_DB_PATH="${ROOT}/data/forge_e2e_$$.sqlite"
mkdir -p "${ROOT}/data"
rm -f "$E2E_DB_PATH"
# Override database URL via environment variable (forge-config supports FORGE_DATABASE_URL)
export FORGE_DATABASE_URL="sqlite://${E2E_DB_PATH}?mode=rwc"
export E2E_DB_PATH

API_PID=""
VITE_PID=""
API_URL="http://${FORGE_BACKEND_HOST}:${FORGE_SERVER_PORT}"
cleanup() {
  if [[ -n "${VITE_PID:-}" ]] && kill -0 "$VITE_PID" 2>/dev/null; then
    kill "$VITE_PID" 2>/dev/null || true
    wait "$VITE_PID" 2>/dev/null || true
  fi
  if [[ -n "${API_PID:-}" ]] && kill -0 "$API_PID" 2>/dev/null; then
    kill "$API_PID" 2>/dev/null || true
    wait "$API_PID" 2>/dev/null || true
  fi
}
trap cleanup EXIT

echo "> test-e2e > starting API server (port $FORGE_SERVER_PORT)"
FORGE_ENVIRONMENT="$FORGE_ENVIRONMENT" FORGE_BACKEND_HOST="$FORGE_BACKEND_HOST" FORGE_SERVER_PORT="$FORGE_SERVER_PORT" FORGE_DATABASE_URL="$FORGE_DATABASE_URL" cargo run -p server --quiet &
API_PID=$!

# Migrations + seeds run before the server binds; can take 60s+ on CI
echo "> test-e2e > waiting for API /healthz (up to 90s)"
for i in {1..180}; do
  if curl -sf --max-time 2 "$API_URL/healthz" >/dev/null 2>&1; then
    break
  fi
  if [[ $i -eq 180 ]]; then
    echo "> test-e2e > API did not become ready in time"
    exit 1
  fi
  sleep 0.5
done

if [[ -f frontend/package.json ]]; then
  echo "> test-e2e > starting Vite dev server (port $FORGE_FRONTEND_PORT, proxy -> $API_URL)"
  (cd frontend && VITE_BACKEND_URL="$API_URL" bun run dev -- --port "$FORGE_FRONTEND_PORT" --strictPort --host "$FORGE_FRONTEND_HOST") &
  VITE_PID=$!

  echo "> test-e2e > waiting for Vite (port $FORGE_FRONTEND_PORT)"
  sleep 2
  for i in {1..60}; do
    code=$(curl -s --max-time 3 -o /dev/null -w '%{http_code}' "http://${FORGE_FRONTEND_HOST}:${FORGE_FRONTEND_PORT}/" 2>/dev/null || echo '000')
    if [[ "$code" =~ ^[2345][0-9][0-9]$ ]] || [[ "$code" =~ ^[2345]$ ]]; then
      break
    fi
    if [[ $i -eq 60 ]]; then
      echo "> test-e2e > Vite did not become ready in time (last code: $code)"
      exit 1
    fi
    sleep 0.5
  done
fi

export E2E_DB_PATH

# Run Playwright e2e tests
PLAYWRIGHT_EXIT=0
if [[ -f crates/test-e2e/package.json ]]; then
  echo "> test-e2e > playwright test (crates/test-e2e)"
  (cd crates/test-e2e && (bun install --frozen-lockfile 2>/dev/null || bun install) && bun run test "$@") || PLAYWRIGHT_EXIT=$?
else
  echo "> test-e2e > no crates/test-e2e/package.json, skipping Playwright"
fi

echo "> test-e2e > done"
[[ $PLAYWRIGHT_EXIT -eq 0 ]] || exit 1

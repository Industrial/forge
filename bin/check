#!/usr/bin/env bash
set -euo pipefail
exec > >(tee log/check.log) 2>&1 

echo "> check"

# Ensure workspace-hack is up-to-date for optimal build performance
echo "> check > cargo hakari generate (workspace-hack optimization)"
cargo hakari generate --quiet || true

echo "> check > cargo check"
RUSTFLAGS='-D warnings' cargo check --lib --all-features

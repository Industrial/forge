#!/usr/bin/env bash
set -euo pipefail

E2E_PORT=30999
E2E_BASE_URL="http://127.0.0.1:${E2E_PORT}"
PREBUILT=".tmp/e2e_prebuilt"

echo "> test-e2e"

# Create and clear .tmp at repo root (matches forge-e2e-lib tmpdir)
mkdir -p .tmp
rm -rf .tmp/*

# Build forge CLI so we can run it
echo "> test-e2e > building forge CLI"
cargo build -p forge-cli

# Create project in .tmp using forge (run from .tmp so project is .tmp/e2e_prebuilt)
echo "> test-e2e > forge new e2e_prebuilt in .tmp"
ROOT="$(pwd)"
(cd .tmp && "$ROOT/target/debug/forge" new e2e_prebuilt)

# Build the generated project
echo "> test-e2e > cargo build (e2e_prebuilt)"
cargo build --manifest-path "$PREBUILT/Cargo.toml"

# Single config and DB for the whole e2e run (server started once below)
echo "> test-e2e > writing config (port $E2E_PORT)"
cat > "$PREBUILT/config/app.toml" <<EOF
[app]
name = "e2e_prebuilt"
environment = "development"

[server]
host = "127.0.0.1"
port = $E2E_PORT
EOF
# Disable seed so tests control data; keep migrations and default db path
cat > "$PREBUILT/config/db.toml" <<'EOF'
[database]
url = "sqlite://db.sqlite?mode=rwc"
max_connections = 5
min_connections = 1
connect_timeout = 10
idle_timeout = 600
auto_migrate = true
auto_seed = false
EOF
rm -f "$PREBUILT/db.sqlite"

# Start server once in background; kill on exit (success or failure)
SERVER_PID=""
cleanup() {
  if [[ -n "${SERVER_PID:-}" ]] && kill -0 "$SERVER_PID" 2>/dev/null; then
    kill "$SERVER_PID" 2>/dev/null || true
    wait "$SERVER_PID" 2>/dev/null || true
  fi
}
trap cleanup EXIT

echo "> test-e2e > starting server (port $E2E_PORT)"
(cd "$PREBUILT" && cargo run --quiet) &
SERVER_PID=$!

# Wait for server readiness (short polling)
echo "> test-e2e > waiting for /healthz"
for i in {1..50}; do
  if curl -sf --max-time 1 "$E2E_BASE_URL/healthz" >/dev/null 2>&1; then
    break
  fi
  if [[ $i -eq 50 ]]; then
    echo "> test-e2e > server did not become ready in time"
    exit 1
  fi
  sleep 0.2
done

# Run all e2e tests in one go (shared server; no per-test spawn)
echo "> test-e2e > cargo test (all e2e tests)"
export E2E_BASE_URL
RUSTFLAGS='-D warnings' cargo test -p forge-e2e-tests
EXIT=$?

echo "> test-e2e > done"
exit $EXIT

#!/usr/bin/env bash
set -euo pipefail

E2E_PORT=30999
E2E_BASE_URL="http://127.0.0.1:${E2E_PORT}"
PREBUILT=".tmp/e2e_prebuilt"

echo "> test-e2e"

# Create and clear .tmp at repo root (matches forge-e2e-lib tmpdir)
mkdir -p .tmp
rm -rf .tmp/*

# Build forge CLI so we can run it
echo "> test-e2e > building forge CLI"
cargo build -p forge-cli

# Create project in .tmp using forge (run from .tmp so project is .tmp/e2e_prebuilt)
echo "> test-e2e > forge new e2e_prebuilt in .tmp"
ROOT="$(pwd)"
(cd .tmp && "$ROOT/target/debug/forge" new e2e_prebuilt)

# Build the generated project (target under repo to avoid noexec on .tmp)
echo "> test-e2e > cargo build (e2e_prebuilt)"
CARGO_TARGET_DIR="$ROOT/target/e2e_prebuilt" cargo build --manifest-path "$PREBUILT/Cargo.toml"

# 018: Build frontend with bun (Inertia/Vite)
if [[ -f "$PREBUILT/frontend/package.json" ]]; then
  echo "> test-e2e > bun install + build (frontend)"
  (cd "$PREBUILT/frontend" && bun install --frozen-lockfile 2>/dev/null || bun install)
  (cd "$PREBUILT/frontend" && bun run build)
fi

# Single config and DB for the whole e2e run (server started once below)
# Production mode so the server serves built frontend from frontend/dist (set by env, not config)
export FORGE_ENVIRONMENT=production
echo "> test-e2e > writing config (port $E2E_PORT)"
cat > "$PREBUILT/config/app.toml" <<EOF
[app]
name = "e2e_prebuilt"

[server]
host = "127.0.0.1"
port = $E2E_PORT

[frontend]
port = 3000
EOF
# Use a writable DB path (TMPDIR) so SQLite is never readonly in Nix/CI or when .tmp is read-only
E2E_DB_PATH="${TMPDIR:-/tmp}/forge_e2e_$$.sqlite"
rm -f "$E2E_DB_PATH"
# Enable seed so auth e2e tests can use seed users (admin@admin.com, viewer@default.org, etc.)
cat > "$PREBUILT/config/db.toml" <<EOF
[database]
url = "sqlite://${E2E_DB_PATH}?mode=rwc"
max_connections = 5
min_connections = 1
connect_timeout = 10
idle_timeout = 600
auto_migrate = true
auto_seed = true
EOF
export E2E_DB_PATH

# Start server once in background; kill on exit (success or failure)
SERVER_PID=""
CHROMEDRIVER_PID=""
cleanup() {
  if [[ -n "${CHROMEDRIVER_PID:-}" ]] && kill -0 "$CHROMEDRIVER_PID" 2>/dev/null; then
    kill "$CHROMEDRIVER_PID" 2>/dev/null || true
    wait "$CHROMEDRIVER_PID" 2>/dev/null || true
  fi
  if [[ -n "${SERVER_PID:-}" ]] && kill -0 "$SERVER_PID" 2>/dev/null; then
    kill "$SERVER_PID" 2>/dev/null || true
    wait "$SERVER_PID" 2>/dev/null || true
  fi
}
trap cleanup EXIT

echo "> test-e2e > starting server (port $E2E_PORT)"
(cd "$PREBUILT" && CARGO_TARGET_DIR="$ROOT/target/e2e_prebuilt" cargo run --quiet) &
SERVER_PID=$!

# Wait for server readiness (short polling)
echo "> test-e2e > waiting for /healthz"
for i in {1..50}; do
  if curl -sf --max-time 1 "$E2E_BASE_URL/healthz" >/dev/null 2>&1; then
    break
  fi
  if [[ $i -eq 50 ]]; then
    echo "> test-e2e > server did not become ready in time"
    exit 1
  fi
  sleep 0.2
done

# Start chromedriver for fantoccini (001_cli browser check)
if command -v chromedriver &>/dev/null; then
  echo "> test-e2e > starting chromedriver (port 9515)"
  chromedriver --port=9515 --log-path=/dev/null 2>/dev/null &
  CHROMEDRIVER_PID=$!
  sleep 1
  export E2E_WEBDRIVER_URL="http://localhost:9515"
fi

# Run all e2e tests in one go (shared server; no per-test spawn)
echo "> test-e2e > cargo test (all e2e tests)"
export E2E_BASE_URL
export E2E_DB_PATH
RUSTFLAGS='-D warnings' cargo test -p forge-e2e-tests
EXIT=$?

echo "> test-e2e > done"
exit $EXIT

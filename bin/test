#!/usr/bin/env bash
set -euo pipefail
exec > >(tee log/test.log) 2>&1

echo "> test"

# Ensure workspace-hack is up-to-date for optimal build performance
echo "> test > cargo hakari generate (workspace-hack optimization)"
cargo hakari generate --quiet || true

echo "> test > cargo nextest (unit tests only, excludes e2e)"
RUSTFLAGS='-D warnings' cargo nextest run --workspace --all-features
